# Dev image: Python + DeepFilterNet engine.
# Source is bind-mounted by docker-compose, so this only installs dependencies.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 git ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --upgrade pip \
    && pip install torch==2.1.2 torchaudio==2.1.2 \
        --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt

COPY . .

EXPOSE 8765
CMD exec uvicorn app.main:app --host 0.0.0.0 --port "${SWEEPR_PORT:-${PORT:-8765}}" --reload
