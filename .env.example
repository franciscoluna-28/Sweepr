# Copy this file to .env before running Docker Compose.
#
#   cp .env.example .env
#
# .env is ignored by git and Docker. Keep it private; it contains the token.

# A long random value shared by everyone who uses this server.
# Generate one with: openssl rand -hex 24
# PowerShell:        [guid]::NewGuid().ToString('N')
# Leave empty to generate a new token on every start (the link changes).
SWEEPR_TOKEN=

# Port published on the server.
SWEEPR_HOST_PORT=8765

# 127.0.0.1 = only this machine.
# 0.0.0.0   = every interface (needed for clients on the LAN).
SWEEPR_BIND=127.0.0.1

# Exact Host header values that may reach Sweepr, comma-separated.
# For LAN access include the port you open in the browser (SWEEPR_HOST_PORT),
# for example: 192.168.1.50:8765
# If you change SWEEPR_HOST_PORT, add that published port here too.
# Behind a TLS proxy on 443, use the domain name: sweepr.example.com
SWEEPR_TRUSTED_HOSTS=
