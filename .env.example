# Sweepr configuration. Copy to .env and adjust. Every value is optional —
# unset variables fall back to the defaults shown here. Invalid values make the
# app fail fast at startup with a message naming the variable.
#
# Byte sizes accept plain integers (bytes) or human suffixes: 5120M, 5G, 5GiB.

# Files per batch job (minimum 1).
SWEEPR_MAX_FILES=10

# Per-file size cap.
SWEEPR_MAX_FILE_BYTES=5G

# Per-job total upload cap (must be >= the per-file cap).
SWEEPR_MAX_TOTAL_BYTES=10G

# Max media duration, in seconds.
SWEEPR_MAX_DURATION_S=14400

# Jobs allowed to wait in the queue (minimum 1).
SWEEPR_MAX_WAITING_JOBS=3

# Days before finished jobs are pruned (0 disables pruning).
SWEEPR_RETENTION_DAYS=7

# Job storage directory (point at a mounted volume in the cloud).
SWEEPR_JOBS_DIR=app/data/jobs

# HTTP port. Falls back to the platform-standard PORT (e.g. Cloud Run / Fly)
# when SWEEPR_PORT is unset.
SWEEPR_PORT=8765
