{
  "openapi": "3.1.0",
  "info": {
    "title": "Sweepr",
    "description": "Local, single-process app that removes background noise from audio files with DeepFilterNet. Files never leave the machine. The Svelte UI is served by this same app; every run \u2014 even a single file \u2014 is a job.",
    "version": "0.3.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Service, model, and limit status",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List jobs, newest first",
        "operationId": "list_jobs_api_jobs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  },
                  "type": "array",
                  "title": "Response List Jobs Api Jobs Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Create a batch job",
        "operationId": "create_job_api_jobs_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_job_api_jobs_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateJobResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Job status and per-file detail",
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      },
      "delete": {
        "tags": [
          "jobs"
        ],
        "summary": "Cancel (if running) and delete a job",
        "operationId": "delete_job_api_jobs__job_id__delete",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteJobResponse"
                }
              }
            },
            "description": "Accepted"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/jobs/{job_id}/files/{index}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Original, enhanced WAV, or muxed video",
        "operationId": "get_file_api_jobs__job_id__files__index__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "index",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Index"
            }
          },
          {
            "name": "which",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "in",
                "out",
                "video"
              ],
              "type": "string",
              "default": "in",
              "title": "Which"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "application/octet-stream": {}
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/jobs/{job_id}/zip": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "All finished results as a zip",
        "operationId": "download_zip_api_jobs__job_id__zip_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "application/octet-stream": {}
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_create_job_api_jobs_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "contentMediaType": "application/octet-stream"
            },
            "type": "array",
            "title": "Files"
          },
          "atten_lim_db": {
            "type": "number",
            "title": "Atten Lim Db",
            "default": 25.0
          },
          "post_filter": {
            "type": "boolean",
            "title": "Post Filter",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_create_job_api_jobs_post"
      },
      "CreateJobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "CreateJobResponse"
      },
      "DeleteJobResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "cancelling",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DeleteJobResponse"
      },
      "ErrorDetail": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorEnvelope",
        "description": "The single error shape every non-2xx response uses."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "models_loaded": {
            "items": {
              "type": "boolean"
            },
            "type": "array",
            "title": "Models Loaded"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "type": "object",
        "required": [
          "status",
          "models_loaded",
          "limits"
        ],
        "title": "Health"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "created": {
            "type": "string",
            "title": "Created"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "done_with_errors",
              "interrupted"
            ],
            "title": "Status"
          },
          "settings": {
            "$ref": "#/components/schemas/JobSettings"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/JobFile"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created",
          "status",
          "settings",
          "files"
        ],
        "title": "Job"
      },
      "JobFile": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "stored": {
            "type": "string",
            "title": "Stored"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "done",
              "error"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "video": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video"
          }
        },
        "type": "object",
        "required": [
          "name",
          "stored",
          "status"
        ],
        "title": "JobFile"
      },
      "JobSettings": {
        "properties": {
          "atten_lim_db": {
            "type": "number",
            "title": "Atten Lim Db"
          },
          "post_filter": {
            "type": "boolean",
            "title": "Post Filter"
          }
        },
        "type": "object",
        "required": [
          "atten_lim_db",
          "post_filter"
        ],
        "title": "JobSettings"
      },
      "Limits": {
        "properties": {
          "max_files": {
            "type": "integer",
            "title": "Max Files"
          },
          "max_file_mb": {
            "type": "integer",
            "title": "Max File Mb"
          },
          "max_total_mb": {
            "type": "integer",
            "title": "Max Total Mb"
          },
          "max_duration_min": {
            "type": "integer",
            "title": "Max Duration Min"
          },
          "allowed_exts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Allowed Exts"
          }
        },
        "type": "object",
        "required": [
          "max_files",
          "max_file_mb",
          "max_total_mb",
          "max_duration_min",
          "allowed_exts"
        ],
        "title": "Limits"
      }
    }
  }
}
